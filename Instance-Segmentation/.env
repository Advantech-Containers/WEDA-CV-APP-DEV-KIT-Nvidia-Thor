# ==============================================================================
# WEDA-CV Instance Segmentation Demo — Static Configuration
# Dynamic values (DISPLAY, XAUTHORITY) are detected at runtime by build.sh
# ==============================================================================

# ── Image ─────────────────────────────────────────────────────────────────────
WEDA_CV_IMAGE=harbor.edgesync.cloud/weda-ai/weda-cv:1.0.0-thor

# ── Container Identity ────────────────────────────────────────────────────────
CONTAINER_NAME=weda-cv-instance-segmentation
SERVICE_NAME=instance-segmentation

# ── NVIDIA Runtime ────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility,graphics,display

# ── CUDA / Library Paths ──────────────────────────────────────────────────────
LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra

# ── Qt / GUI Stability ────────────────────────────────────────────────────────
QT_X11_NO_MITSHM=1
NO_AT_SPI=1
DBUS_SESSION_BUS_ADDRESS=/dev/null

# ── EULA ──────────────────────────────────────────────────────────────────────
ACCEPT_ULTRALYTICS_EULA=false

# ── BYOL Packages ─────────────────────────────────────────────────────────────
# Ultralytics is installed at runtime (BYOL) into a named volume, so it is
# downloaded once per device instead of on every container launch.
# Purge the volume with: ./build.sh --clean
BYOL_VOLUME=weda-cv-instance-segmentation-byol
ULTRALYTICS_VERSION=8.4.24
ULTRALYTICS_THOP_VERSION=2.0.18

# ── Hydration ─────────────────────────────────────────────────────────────────
# Seconds build.sh waits for first-run hydration (apt + BYOL install).
# Cold runs on slow links legitimately exceed 60s; subsequent runs are instant.
HYDRATION_TIMEOUT=300

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILE=3
