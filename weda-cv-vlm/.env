# ==============================================================================
# WEDA-CV VLM Pipeline — environment template
#
# Fill in the placeholders, then run:
#     ./build.sh
#
# DISPLAY and XAUTHORITY are auto-detected at runtime by build.sh.
# ==============================================================================

# ── Image ─────────────────────────────────────────────────────────────────────
WEDA_CV_IMAGE=harbor.edgesync.cloud/weda-ai/weda-gpu-passthrough:1.0.0-thor

# ── Container Identity ────────────────────────────────────────────────────────
CONTAINER_NAME=weda-cv-vlm
SERVICE_NAME=weda-cv-vlm

# ── NVIDIA Runtime ────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,video,utility,graphics,display

# ── CUDA / Library Paths ──────────────────────────────────────────────────────
LD_LIBRARY_PATH=/usr/local/lib:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra

# ── Qt / GUI Stability ────────────────────────────────────────────────────────
QT_X11_NO_MITSHM=1
NO_AT_SPI=1
DBUS_SESSION_BUS_ADDRESS=/dev/null

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required for gated repos (Cosmos-Reason2-2B, Llama-3.1-Nemotron-Nano-VL).
# Generate at https://huggingface.co/settings/tokens.
HF_TOKEN=

# ── EULA ──────────────────────────────────────────────────────────────────────
# Set to `true` once you have read and accepted the Ultralytics commercial
# license. Without this, YOLO is not installed by entrypoint.sh.
ACCEPT_ULTRALYTICS_EULA=false

# ── Model Cache (persistent across container restarts) ────────────────────────
MODEL_CACHE_DIR=./model_cache

# ── Pipeline Defaults ─────────────────────────────────────────────────────────
PIPELINE_SOURCE=synthetic
PIPELINE_HEADLESS=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILE=3

# ── HTTP API (optional overrides) ─────────────────────────────────────────────
# Uncomment and set to override config/pipeline.yaml's `api:` block at deploy
# time. Useful for closed-LAN booths where you want bind=0.0.0.0 without
# editing the YAML in a read-only mount.
#WEDA_API_BIND=0.0.0.0
#WEDA_API_PORT=9180
#WEDA_API_TOKEN=

# ── Dep resolver (optional) ───────────────────────────────────────────────────
# Set to `false` to disable transformers' auto-pip retry on missing-package
# load failures. When false, the operator must pre-install vision-stack deps
# (timm, open_clip_torch, etc.) manually.
WEDA_AUTO_PIP=true
